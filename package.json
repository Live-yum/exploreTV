{
  "name": "exploretv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dev:h5": "UNI_INPUT_DIR=. uni",
    "build:h5": "UNI_INPUT_DIR=. uni build",
    "build:mp-weixin": "UNI_INPUT_DIR=. uni build -p mp-weixin",
    "test:real": "node scripts/verify-world.mjs",
    "dev:viewer": "node scripts/serve-viewer.mjs",
    "prepare:example": "node scripts/prepare-example.mjs",
    "prepare:overview": "node scripts/prepare-overview.mjs",
    "prepare:overview-frames": "node scripts/build-overview-frame-pack.mjs",
    "prepare:world": "node --expose-gc --max-old-space-size=48 --max-semi-space-size=1 scripts/prepared-world.mjs prepare",
    "export:prepared": "node --expose-gc --max-old-space-size=48 --max-semi-space-size=1 scripts/prepared-world.mjs replay",
    "encode:overview": "node --expose-gc scripts/encode-overview.mjs",
    "render:full": "node scripts/render-full-world.mjs",
    "export:full": "node scripts/export-world.mjs",
    "export:overview": "node --expose-gc --max-old-space-size=48 --max-semi-space-size=1 scripts/export-overview.mjs"
  },
  "dependencies": {
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-app": "3.0.0-alpha-5010220260604001",
    "@dcloudio/uni-components": "3.0.0-alpha-5010220260604001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5010220260604001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5010220260604001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5010220260604001",
    "@napi-rs/canvas": "^0.1.80",
    "@playwright/test": "^1.58.2",
    "node-api-headers": "1.8.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
